generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Статусы хранятся как String со значениями
// "PENDING" | "NEEDS_ATTENTION" | "APPROVED" | "REJECTED" (для Restaurant) и
// "PENDING" | "APPROVED" | "REJECTED" (для Review) — см. константы
// RestaurantStatus / ReviewStatus в src/lib/status.ts.

model Restaurant {
  id String @id @default(cuid())

  name String

  // Адрес, введённый пользователем
  addressInput String
  // Адрес, нормализованный Яндекс.Геокодером (если удалось распознать)
  addressResolved String?
  // Координаты для карты (null, пока адрес не подтверждён)
  lat Float?
  lng Float?
  // Точность совпадения от геокодера: exact | number | near | range | street | other | null
  geoPrecision String?

  status         String  @default("PENDING")
  moderationNote String? // причина отправки в "требует внимания" / отклонения

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews Review[]

  @@index([status])
}

model Review {
  id String @id @default(cuid())

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String

  authorName String
  rating     Int // 1..5

  text String

  // Состав бизнес-ланча, актуальный на момент отзыва
  lunchComposition String
  price            Int?

  status         String  @default("PENDING")
  moderationNote String?

  createdAt DateTime @default(now())

  @@index([restaurantId, status])
  @@index([status, createdAt])
}
