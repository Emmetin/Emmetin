# Строка подключения к Postgres (Neon / Vercel Postgres / Supabase и т.д.)
# На Vercel serverless-функции не имеют постоянного диска, поэтому SQLite-файл
# не подходит — нужна внешняя БД. Если провайдер даёт отдельную "pooled"
# строку подключения (через pgbouncer) — используйте её: это важно для
# работы из serverless-функций с большим числом параллельных подключений.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Ключ JS API Яндекс.Карт (нужен для отображения карты в браузере)
# Получить: https://developer.tech.yandex.ru/
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=""

# Ключ HTTP Геокодера Яндекс (нужен для проверки адресов на сервере)
# Может совпадать с ключом карт, но обычно выпускается отдельно
YANDEX_GEOCODER_API_KEY=""

# Учётные данные администратора
ADMIN_LOGIN="admin"
# Сгенерировать хеш: node -e "console.log(require('bcryptjs').hashSync('пароль', 10))"
# Важно: Next.js раскрывает "$var" в .env (dotenv-expand), а bcrypt-хеш
# содержит символы "$" — экранируйте их обратным слэшем, например:
# ADMIN_PASSWORD_HASH="\$2a\$10\$abcdefghijklmnopqrstuv"
ADMIN_PASSWORD_HASH=""

# Секрет для подписи сессионной cookie администратора (любая длинная случайная строка)
SESSION_SECRET="change-me-to-a-random-string"
